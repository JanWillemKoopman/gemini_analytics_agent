# Copy to .env.local. Publishable key is safe client-side; the service_role key below is
# NOT — never prefix it with NEXT_PUBLIC_, never send it to the client.
NEXT_PUBLIC_SUPABASE_URL=https://pzpoptfljgrskebnuggt.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ph-BpC3ftPyPMpbUzuM--A_2yxvz2Kq

# Server-only. Powers /settings (bulk account creation): Supabase Project Settings → API
# → service_role secret. Bypasses RLS entirely — only used from API route handlers
# (lib/supabase/admin.ts), never imported into a client component.
SUPABASE_SERVICE_ROLE_KEY=

# Modal enqueue endpoint (from `modal deploy`); leave blank until the worker is deployed —
# jobs still get picked up by the worker's 1-minute poll_queue fallback.
MMM_MODAL_ENQUEUE_URL=

# Production Anthropic key for the chat "architect" (app/api/chat) — deliberately
# separate from the personal Claude Code login used to BUILD this app. Create at
# https://console.anthropic.com. Server-only, never NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
