# Dataloket — zie README-dataloket.md voor de stappen.
# Zonder deze variabelen blijft het campagnedashboard gewoon werken; alleen het
# chattabblad toont dan welke er nog ontbreken.

# Inloggen en het querylog
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Uitsluitend voor scripts/maak-gebruiker.ts (collega-accounts aanmaken/wachtwoord
# zetten) — NOOIT in de app zelf gebruiken en NOOIT als NEXT_PUBLIC_-variabele: deze
# sleutel omzeilt alle rijbeveiliging. Te vinden in Supabase onder
# Project Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=

# De READ-ONLY verbinding waarop de chat draait (rol dataloket_lezer, pooler poort 6543).
# Deze rol heeft uitsluitend SELECT op de v_-views.
DATAQUERY_DATABASE_URL=

# Claude API
ANTHROPIC_API_KEY=

# Optioneel: het model waarop de chat draait. Standaard claude-haiku-4-5 (testfase,
# goedkoop). Zet op claude-opus-5 zodra de antwoordkwaliteit belangrijker is dan de kosten.
# CHAT_MODEL=claude-opus-5

# Optioneel: het model waarop wordt overgestapt zodra het goedkope model vastloopt op een
# query, de aanroep mislukt, of de gebruiker om een nieuw antwoord vraagt.
# Standaard claude-sonnet-5.
# CHAT_MODEL_ESCALATIE=claude-opus-5

# SCHRIJVENDE verbinding, uitsluitend voor de sync-job. Nooit dezelfde als DATAQUERY_DATABASE_URL.
SYNC_DATABASE_URL=

# Beschermt /api/sync tegen aanroepen van buiten. Genereer iets willekeurigs.
CRON_SECRET=

# Optioneel: andere sheet voor het bestaande campagnedashboard
# GOOGLE_SHEET_ID=

# Schrijven vanuit het dashboard terug naar de "Campagnes"-sheet (inline-edit in de
# tabel). Zonder deze twee variabelen blijft de tabel gewoon read-only, zoals nu.
# Service account met Editor-toegang op de sheet, scope .../auth/spreadsheets.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Plak de private_key uit het JSON-keybestand inclusief de \n's, tussen aanhalingstekens.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Windsor.ai — de datafeed voor het tabblad Social media (Facebook). De sleutel staat in
# Windsor.ai onder Destinations → Python/R Code, in de URL achter api_key=. Server-only:
# de sleutel gaat mee in de query-string van elke Windsor-aanroep, dus NOOIT als
# NEXT_PUBLIC_-variabele. Zonder deze variabele blijft de rest van het dashboard werken;
# het tabblad Facebook vertelt dan wat er ontbreekt. Zie README-social.md.
WINDSOR_API_KEY=
